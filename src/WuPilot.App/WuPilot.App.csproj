<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WuPilot.App</RootNamespace>
    <AssemblyName>WuPilot</AssemblyName>
    <Product>WuPilot Windows Update Workbench</Product>
    <Description>Technician-focused Windows Update Agent diagnostics and Intune driver evidence workbench.</Description>
    <Version>0.2.0</Version>
    <ApplicationIcon>Assets\WuPilot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnablePriGenTooling>true</EnablePriGenTooling>
    <EnableCoreMrtTooling>true</EnableCoreMrtTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WuPilot.Core/WuPilot.Core.csproj" />
    <ProjectReference Include="../WuPilot.Infrastructure.Windows/WuPilot.Infrastructure.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\WuPilot.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyWinUiResourcesToPublishOutput" AfterTargets="Publish">
    <Copy
      SourceFiles="$(TargetDir)$(ProjectPriFileName)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(TargetDir)$(ProjectPriFileName)')" />
    <ItemGroup>
      <CompiledXamlResources Include="$(IntermediateOutputPath)*.xbf" />
    </ItemGroup>
    <Copy
      SourceFiles="@(CompiledXamlResources)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="'@(CompiledXamlResources)' != ''" />
  </Target>
</Project>
