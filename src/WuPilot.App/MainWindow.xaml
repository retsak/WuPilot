<Window
    x:Class="WuPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WuPilot">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="18" HorizontalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="WuPilot" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Windows Update Workbench" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="2" Margin="8,0,144,0" Padding="10,4" CornerRadius="12" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" VerticalAlignment="Center">
                <TextBlock Text="Administrator" FontSize="12" />
            </Border>
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ScanNav" Content="Scan and review" Tag="scan" Icon="Find" IsSelected="True" />
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity" Icon="Clock" />
                <NavigationViewItem Content="About" Tag="about" Icon="Help" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="ScanView" Padding="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Scan and review" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Compare applicable updates across policy-managed and direct Microsoft sources." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="Export_Click" IsEnabled="{x:Bind HasScanReport, Mode=OneWay}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock Text="Export evidence" /></StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Update sources" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{x:Bind ProviderOptions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding DisplayName}" MinWidth="190" Margin="0,0,8,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox x:Name="CustomServiceIdBox" Header="Custom service ID (optional)" PlaceholderText="WUA service GUID" Width="360" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <TextBox x:Name="OfflineCabPathBox" Header="Offline catalog (optional)" PlaceholderText="C:\support\Wsusscn2.cab — security metadata only; no drivers" Width="520" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Search profile" FontWeight="SemiBold" />
                                <ComboBox x:Name="PresetCombo" ItemsSource="{x:Bind PresetOptions}" DisplayMemberPath="DisplayName" SelectedIndex="2" SelectionChanged="PresetCombo_SelectionChanged" HorizontalAlignment="Stretch" />
                                <TextBox x:Name="CustomCriteriaBox" Header="Custom WUA criteria" PlaceholderText="IsInstalled=0 and Type='Driver'" Visibility="Collapsed" />
                                <CheckBox x:Name="SupersededCheck" Content="Include potentially superseded updates" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="8">
                                <Button x:Name="ScanButton" Content="Start scan" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" MinWidth="120" />
                                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" MinWidth="120" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="460" /><ColumnDefinition Width="2*" MinWidth="330" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Results" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ResultSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox x:Name="FilterBox" Grid.Column="1" Width="220" PlaceholderText="Filter results" TextChanged="FilterBox_TextChanged" />
                                </Grid>
                                <ListView x:Name="UpdatesList" Grid.Row="1" ItemsSource="{x:Bind VisibleUpdates}" SelectionChanged="UpdatesList_SelectionChanged" SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8" MinHeight="74">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE777;" FontSize="16" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxLines="2" />
                                                    <TextBlock Text="{Binding Metadata}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource WuPilotAccentBrush}" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                                    <Border Padding="6,2" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="{Binding TypeLabel}" FontSize="11" /></Border>
                                                    <TextBlock Text="{Binding SizeLabel}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                            <ScrollViewer>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Update details" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock x:Name="DetailTitle" Text="Select an update to inspect its evidence." TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="6" />
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="Identity" FontWeight="SemiBold" /><TextBlock x:Name="DetailIdentity" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                        <TextBlock Grid.Row="1" Text="Sources" FontWeight="SemiBold" /><TextBlock x:Name="DetailSources" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Text="Manufacturer" FontWeight="SemiBold" /><TextBlock x:Name="DetailManufacturer" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Text="Model / class" FontWeight="SemiBold" /><TextBlock x:Name="DetailModel" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Text="Hardware ID" FontWeight="SemiBold" /><TextBlock x:Name="DetailHardware" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                        <TextBlock Grid.Row="5" Text="Version / date" FontWeight="SemiBold" /><TextBlock x:Name="DetailDate" Grid.Row="5" Grid.Column="1" />
                                        <TextBlock Grid.Row="6" Text="Installed now" FontWeight="SemiBold" /><TextBlock x:Name="DetailInstalled" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="7" Text="Signature / match" FontWeight="SemiBold" /><TextBlock x:Name="DetailSignature" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="8" Text="Categories" FontWeight="SemiBold" /><TextBlock x:Name="DetailCategories" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" />
                                    </Grid>
                                    <InfoBar x:Name="DetailWarning" Severity="Warning" IsOpen="False" IsClosable="False" Title="Review before installation" Message="Direct installation tests this device only. Use the evidence bundle and Intune deployment rings for broad rollout." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DownloadButton" Content="Download" Click="UpdateAction_Click" Tag="Download" IsEnabled="False" />
                                        <Button x:Name="InstallButton" Content="Install" Click="UpdateAction_Click" Tag="Install" IsEnabled="False" />
                                        <Button x:Name="HideButton" Content="Hide" Click="UpdateAction_Click" Tag="Hide" IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="DiagnosticsView" Visibility="Collapsed" Padding="24,16,24,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Diagnostics and repair" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Read local policy, service, proxy, DNS, WUA, join, and reboot state before changing the device." Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <Button Grid.Column="1" Content="Refresh checks" Click="Diagnostics_Click" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Bounded repair actions" FontWeight="SemiBold" />
                            <TextBlock Text="Each action shows a confirmation. Reset cache renames stores to timestamped recovery paths; it never deletes them." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Start required services" Tag="StartRequiredServices" Click="Repair_Click" />
                                <Button Content="Reset update cache" Tag="ResetWindowsUpdateCache" Click="Repair_Click" />
                                <Button Content="DISM ScanHealth" Tag="ScanComponentStore" Click="Repair_Click" />
                                <Button Content="DISM RestoreHealth" Tag="RestoreComponentStore" Click="Repair_Click" />
                                <Button Content="Generate WindowsUpdate.log" Tag="GenerateWindowsUpdateLog" Click="Repair_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionCardStyle}"><StackPanel><TextBlock Text="Findings" FontWeight="SemiBold" Margin="0,0,0,8" /><ListView ItemsSource="{x:Bind DiagnosticFindings}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{StaticResource WuPilotAccentBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}"><ScrollViewer><StackPanel Spacing="8"><TextBlock Text="Recent update history" FontWeight="SemiBold" /><ItemsControl ItemsSource="{x:Bind UpdateHistory}"><ItemsControl.ItemTemplate><DataTemplate><Grid Padding="0,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Date}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding ResultCode}" FontFamily="Consolas" HorizontalAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Service state" FontWeight="SemiBold" Margin="0,12,0,0" /><ItemsControl ItemsSource="{x:Bind ServiceStates}"><ItemsControl.ItemTemplate><DataTemplate><Grid Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Key}" FontFamily="Consolas" /><TextBlock Grid.Column="1" Text="{Binding Value}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Policy evidence" FontWeight="SemiBold" Margin="0,12,0,0" /><ItemsControl ItemsSource="{x:Bind PolicyStates}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Padding="0,4"><TextBlock Text="{Binding Key}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" /><TextBlock Text="{Binding Value}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
                    </Grid>
                </Grid>

                <Grid x:Name="ActivityView" Visibility="Collapsed" Padding="24,16,24,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Actions and results from this session. Exported evidence is the durable record." Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,16,0,0"><ListView ItemsSource="{x:Bind ActivityItems}"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate></ListView></Border>
                </Grid>

                <Grid x:Name="AboutView" Visibility="Collapsed" Padding="24,16,24,20">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="About WuPilot" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="WuPilot is a technician workbench for inspecting Windows Update Agent behavior, comparing scan sources, validating one-device applicability, and creating an evidence handoff for Intune administrators." TextWrapping="Wrap" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Policy-aware, not policy-breaking" Message="Direct-source scans are diagnostic comparisons. Windows policy, endpoint access, service registration, and Microsoft applicability rules still apply." />
                        <TextBlock Text="Safety model" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="The application requires elevation, serializes WUA operations, keeps installation user-confirmed, does not auto-reboot, and uses recoverable cache resets. Evidence bundles can contain device and tenant identifiers; handle them as support data." TextWrapping="Wrap" />
                        <TextBlock Text="Microsoft references" FontWeight="SemiBold" FontSize="18" />
                        <HyperlinkButton Content="WinUI 3 documentation" NavigateUri="https://learn.microsoft.com/windows/apps/winui/winui3/" />
                        <HyperlinkButton Content="Windows Update Agent API" NavigateUri="https://learn.microsoft.com/windows/win32/wua_sdk/using-the-windows-update-agent-api" />
                        <HyperlinkButton Content="Manage Windows driver updates in Intune" NavigateUri="https://learn.microsoft.com/intune/device-updates/windows/manage-driver-updates" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <Grid Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" /><TextBlock x:Name="StatusText" Text="Ready" FontSize="12" /></StackPanel>
            <TextBlock Grid.Column="1" x:Name="ProgressText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
